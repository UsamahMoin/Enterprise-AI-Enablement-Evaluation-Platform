# ---------------------------------------------------------------------------
# Enterprise AI Enablement Lab - example environment
# Copy to .env and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
POSTGRES_USER=eail
POSTGRES_PASSWORD=eail_dev_password
POSTGRES_DB=eail
DATABASE_URL=postgresql+asyncpg://eail:eail_dev_password@db:5432/eail

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Password for every seeded demo account (demo data only, synthetic users).
DEMO_PASSWORD=demo1234

# --- AI provider ----------------------------------------------------------
# stub   deterministic offline fixtures - no API key, no spend (default)
# openai hosted frontier models via the Responses API
# local  self-hosted model over an OpenAI-compatible API (Ollama, LM Studio)
AI_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EVALUATION_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# --- Self-hosted inference -------------------------------------------------
# Ollama:    http://localhost:11434/v1   (ollama serve)
# LM Studio: http://localhost:1234/v1
# llama.cpp: http://localhost:8080/v1
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=qwen3:8b
LOCAL_AI_API_KEY=
# Local inference is slow on modest hardware; budget generously.
LOCAL_REQUEST_TIMEOUT_SECONDS=300

# --- Evaluation routing ----------------------------------------------------
# Provider for the LLM-as-judge step. Empty uses the generation provider.
# Setting it to a DIFFERENT provider is the point: a model grading its own
# output shows self-preference bias, so an independent judge is a cheap
# mitigation. It also lets sensitive output be judged locally while generation
# stays hosted, or the reverse.
EVALUATION_PROVIDER=

# --- Moderation ------------------------------------------------------------
# Self-hosted runtimes have no moderation endpoint. Name a provider here to
# delegate the check. If none can check, the result is recorded as "not
# checked" - never as "passed" - and the safety dimension is dropped from the
# score rather than awarded full marks.
MODERATION_PROVIDER=
# Set true in a regulated deployment: reject input nobody could moderate.
MODERATION_FAIL_CLOSED=false

# --- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
