# ---------------------------------------------------------------------------
# Enterprise AI Enablement Lab - example environment
# Copy to .env and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
POSTGRES_USER=eail
POSTGRES_PASSWORD=eail_dev_password
POSTGRES_DB=eail
DATABASE_URL=postgresql+asyncpg://eail:eail_dev_password@db:5432/eail

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Password for every seeded demo account (demo data only, synthetic users).
DEMO_PASSWORD=demo1234

# --- AI provider ----------------------------------------------------------
# Leave AI_PROVIDER=stub to run the full platform with deterministic, offline
# responses (no API key, no spend). Set to "openai" for live generation.
AI_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EVALUATION_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# --- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
